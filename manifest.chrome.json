{
  "name": "SearchExtender",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Search extender for omnibox and contextmenu",
  "author": "yak_ex",
  "omnibox": {
    "keyword" : "go"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [ "contextMenus", "storage", "activeTab", "scripting" ],
  "optional_permissions": [ "clipboardRead" ]
}
